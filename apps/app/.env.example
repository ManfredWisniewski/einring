# Copy to `.env.local` (gitignored). All values are public; PKCE needs no secret.

# Authentik issuer, e.g. https://auth.example.com/application/o/einring/
VITE_AUTHENTIK_ISSUER=
# Client ID of the public OIDC provider "einring" in Authentik
VITE_AUTHENTIK_CLIENT_ID=
# Base URL of the BFF. Leave empty in the browser (same origin, Vite proxies /api).
# For Android builds set the full URL, e.g. https://einring.example.com or http://10.0.2.2:3001 (emulator)
VITE_API_URL=

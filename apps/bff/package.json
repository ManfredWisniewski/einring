{
  "name": "@einring/bff",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend: validates Authentik tokens, holds Nextcloud app passwords, proxies service APIs, serves the web build.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "fast-xml-parser": "^4.5.7",
    "fastify": "^5.7.4",
    "imapflow": "^2.5.2",
    "jose": "^6.1.3",
    "postal-mime": "^4.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}

# Copy to `.env` (root, used by the BFF) and fill in your values. Never commit `.env`.

# --- Authentik (OIDC) ------------------------------------------------------
# Issuer URL of the Authentik provider, e.g. https://auth.example.com/application/o/einring/
AUTHENTIK_ISSUER=
# Client ID of the public (PKCE) OAuth2/OIDC provider created for einring
AUTHENTIK_CLIENT_ID=

# --- Nextcloud -------------------------------------------------------------
# Base URL of the Nextcloud instance (no trailing slash), e.g. https://cloud.example.com
NEXTCLOUD_URL=
# Comma-separated enabled module ids; leave unset to enable all registered modules
# MODULES=tables,monitor,wiki,csv-manager,einmusic,eindav,recipes
# Per-module settings use MODULE_<ID>_<KEY>; the tables module consumes this Nextcloud Tables
# application (context) — the id from its /app/<id> URL in Nextcloud (requires Tables app)
MODULE_TABLES_APPLICATION_ID=
# Wiki: seconds a sync result is cached before GET /api/wiki/tree re-syncs (default 300)
# MODULE_WIKI_SYNC_TTL_S=300
# Wiki: DAV folder holding the collectives (default .Collectives; older Nextcloud used Collectives)
# MODULE_WIKI_ROOT=.Collectives
# Wiki dev seeding: mirror a local directory (basename = collective name) instead of WebDAV
# MODULE_WIKI_SOURCE_DIR=P:\path\to\.Collectives\WIT
# Shared LLM provider (D41): OpenAI-compatible /v1 for "Ask the wiki" (RAG) and
# EinChat tool calling. Unset = both features disabled. OpenRouter is the default
# provider; local servers (llama-server, LM Studio, Ollama /v1) work the same
# way — then LLM_API_KEY is unneeded.
# Privacy: retrieved wiki chunks, chat messages and tool results are sent to this provider.
# LLM_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_CHAT_MODEL=google/gemini-2.5-flash
# LLM_EMBED_MODEL=openai/text-embedding-3-small
# Wiki RAG: chunks per answer prompt (default 8), provider timeout seconds (default 60)
# LLM_TOP_K=8
# LLM_TIMEOUT_S=60
# Connector modules (D41): optional default instance URLs for the connect form;
# users link their own credentials in the app (per-user, stored sealed).
# MODULE_YAMTRACK_URL=https://yamtrack.example.com
# MODULE_AUDIOBOOKSHELF_URL=https://abs.example.com
# MODULE_NAVIDROME_URL=https://music.example.com
# MODULE_TREK_URL=https://trek.example.com
# Email module (A16): default IMAP server for the connect form — imaps://host:993
# or bare host[:port]. Users log in with their own mail credentials per account.
# MODULE_EMAIL_URL=imaps://imap.example.com:993
# MODULE_GOTIFY_URL=https://push.example.com
# MODULE_GITLAB_URL=https://gitlab.example.com
# MODULE_GITHUB_URL=https://github.com
# MODULE_AUTHENTIK_URL=https://auth.example.com
# MODULE_MATRIX_URL=https://matrix.example.com

# EinHub: min seconds between upstream notification refreshes per user (default 60)
# MODULE_EINHUB_REFRESH_SECONDS=60
# CSV Manager: max import body size in bytes (default 5242880 = 5 MiB)
# MODULE_CSV_MANAGER_MAX_BYTES=5242880
# CSV Manager: max data rows accepted per imported file (default 20000)
# MODULE_CSV_MANAGER_MAX_ROWS=20000

# --- BFF -------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
# Directory for the SQLite database (created if missing)
DATA_DIR=./data
# 32 bytes, base64-encoded; encrypts stored Nextcloud app passwords.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Public URL of the BFF/web app as seen by browsers (used to build login-flow redirect targets)
PUBLIC_URL=http://localhost:5173
# --- Whitelabel (per deployment, no rebuild) --------------------------------
# Display name of this deployment (app header, browser tab, info dialog). Default: Einring
# INSTANCE_NAME=Einring
# Login-page tagline. Unset = app default; set to "" to hide it.
# INSTANCE_TAGLINE=
# Named biti theme shipped with the BFF (apps/bff/themes/<name>.json); injected into
# index.html per color scheme. Available: wuttke. Unset = einring's own token values.
# INSTANCE_THEME=wuttke
# Branding overrides as a JSON map of CSS variables, injected into index.html (wins over the theme).
# INSTANCE_CSS_VARS={"--accent-base":"#b91c1c","--accent-subtle":"#fee2e2"}
